<!-- AIKYA MEMORY VIEWER schema=1 -->
<!doctype html>
<html lang="@@LANG@@" data-mode="@@MODE@@">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="@@CSP@@">
<title>Aikya Memory</title><style>@@CSS@@</style></head>
<body>
<header class="topbar"><a class="wordmark" href="#">aikya<span> / memory</span></a><div class="actions"><span id="connection" role="status"></span><button id="motion" type="button"></button><button id="theme" type="button"></button></div></header>
<section class="intro"><div><p class="eyebrow" data-i18n="eyebrow"></p><h1 data-i18n="headline"></h1><p class="muted" id="project"></p></div><div id="metrics" aria-live="polite"></div></section>
<main class="workspace">
<aside class="sources"><h2 data-i18n="structure"></h2><p class="muted" data-i18n="treeHint"></p><div id="tree"></div></aside>
<section class="explorer" aria-label="Memory explorer"><div class="toolbar"><nav id="views" aria-label="Views"><button type="button" data-view="graph" aria-pressed="true" data-i18n="graph"></button><button type="button" data-view="architecture" aria-pressed="false" data-i18n="architecture"></button><button type="button" data-view="inventory" aria-pressed="false" data-i18n="inventory"></button></nav><label class="search"><span class="sr-only" data-i18n="search"></span><input id="search" type="search" autocomplete="off"></label></div>
<div class="filters"><label><span data-i18n="type"></span><select id="type"><option value="all" data-i18n="allTypes"></option></select></label><label><span data-i18n="folder"></span><select id="folder"><option value="all" data-i18n="allFolders"></option></select></label><button id="neighbors" type="button" aria-pressed="false" data-i18n="neighbors"></button><div class="zoom"><button id="zoom-out" type="button" aria-label="Zoom out">−</button><button id="zoom-in" type="button" aria-label="Zoom in">+</button><button id="zoom-reset" type="button" data-i18n="reset"></button></div></div>
<p id="coverage" role="status"></p>
<div id="stage"><svg id="graph" viewBox="0 0 1000 650" role="group" aria-label="Knowledge graph"><g id="canvas"></g></svg><div id="inventory" hidden></div><p id="empty" hidden></p></div>
<div class="map-footer"><span id="shown"></span><div id="pages"><button id="previous" type="button" data-i18n="previous"></button><span id="page"></span><button id="next" type="button" data-i18n="next"></button></div><span data-i18n="evidenceOnly"></span></div>
</section>
<aside class="inspector"><p class="eyebrow" data-i18n="inspector"></p><h2 id="detail-title"></h2><p id="detail-type" class="muted"></p><p id="detail-path" class="mono"></p><pre id="detail-body"></pre><div id="connections"></div><p class="evidence-note" data-i18n="traceHint"></p></aside>
</main><footer><span id="snapshot-time"></span><span>GENERATED BY AIKYA HARNESS</span></footer>
<script type="application/json" id="snapshot">@@DATA@@</script><script>@@SCRIPT@@</script>
</body></html>
